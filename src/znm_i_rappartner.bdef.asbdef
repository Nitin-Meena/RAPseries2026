managed implementation in class zbp_nm_demo_rappartner unique;
strict ( 2 );

define behavior for Znm_I_RAPPartner alias Partner
persistent table znm_dmo_partner
lock master
authorization master ( instance )

{
  create ( authorization : global );
  update;
  delete;
//  field ( mandatory : create ) PartnerNumber;

validation validateKeyIsFilled on save { create; }

validation validateCoreData on save { create; field Country, PaymentCurrency; }

determination fillCurrency on modify { create; update; }

action fillEmptyStreets result [1] $self;

static action clearAllEmptyStreets;

factory action copyLine [1];

static action withPopup parameter Znm_I_PopupEntity;

  mapping for znm_dmo_partner
    {
      PartnerNumber   = partner;
      PartnerName     = name;
      Street          = street;
      City            = city;
      Country         = country;
      PaymentCurrency = payment_currency;
    }
}